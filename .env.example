# =====================================================
# Variables de entorno para Docker Compose
# Copiar este archivo como .env y modificar los valores
# =====================================================

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ABCabc123
POSTGRES_DB=studentgest

# Configuración de Email (Gmail)
# Para usar Gmail, necesitas crear una "App Password"
# Ver: https://support.google.com/accounts/answer/185833
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password

# JWT Secret (cambiar en producción)
JWT_SECRET=mySecretKeyForJWTGenerationInStudentGestApplication2024

# Configuración del servidor
SERVER_PORT=8080
